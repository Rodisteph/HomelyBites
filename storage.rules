rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function validImageWrite() {
      return request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /profilePhotos/{uid}/{fileName} {
      allow read: if true;
      allow write: if isOwner(uid) && validImageWrite();
    }

    match /mealPhotos/{uid}/{mealId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(uid) && validImageWrite();
    }

    match /masterclassPhotos/{uid}/{classId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(uid) && validImageWrite();
    }
  }
}
