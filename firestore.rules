rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isHost(uid) {
      return isOwner(uid)
        && get(/databases/$(database)/documents/users/$(uid)).data.role == "host";
    }

    function isOrderParticipant() {
      return isSignedIn()
        && (
          resource.data.clientId == request.auth.uid
          || resource.data.hostId == request.auth.uid
        );
    }

    function paymentStatusUnchanged() {
      return request.resource.data.paymentStatus == resource.data.paymentStatus;
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create, update, delete: if isOwner(uid);
    }

    match /meals/{mealId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.hostId == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "host"
        && request.resource.data.priceCents is int
        && request.resource.data.priceCents > 0
        && request.resource.data.availablePortions is int
        && request.resource.data.availablePortions > 0
        && request.resource.data.isPublic is bool;

      allow update: if isSignedIn()
        && resource.data.hostId == request.auth.uid
        && request.resource.data.hostId == resource.data.hostId;

      allow delete: if isSignedIn()
        && resource.data.hostId == request.auth.uid;
    }

    match /orders/{orderId} {
      allow read: if isOrderParticipant();
      allow create, update, delete: if false;
    }
  }
}
