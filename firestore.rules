rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isHost(uid) {
      return isOwner(uid)
        && get(/databases/$(database)/documents/users/$(uid)).data.role == "host";
    }

    function hostHasHaccp(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.haccpAcceptedAt is timestamp
        && get(/databases/$(database)/documents/users/$(uid)).data.haccpVersion is string
        && get(/databases/$(database)/documents/users/$(uid)).data.haccpVersion.size() > 0;
    }

    function isOrderParticipant() {
      return isSignedIn()
        && (
          resource.data.clientId == request.auth.uid
          || resource.data.hostId == request.auth.uid
        );
    }

    function paymentStatusUnchanged() {
      return request.resource.data.paymentStatus == resource.data.paymentStatus;
    }

    function isValidOrderCreate() {
      return request.resource.data.clientId == request.auth.uid
        && request.resource.data.hostId is string
        && request.resource.data.hostId.size() > 0
        && request.resource.data.mealId is string
        && request.resource.data.mealId.size() > 0
        && request.resource.data.amountCents is int
        && request.resource.data.amountCents > 0
        && request.resource.data.status == "pending"
        && request.resource.data.paymentStatus == "requires_payment";
    }

    function isMealOwner() {
      return isSignedIn()
        && (
          (resource.data.hostId is string && resource.data.hostId == request.auth.uid)
          || (resource.data.ownerId is string && resource.data.ownerId == request.auth.uid)
        );
    }

    function isValidServiceMode(serviceMode) {
      return serviceMode == null
        || (serviceMode is string
          && (serviceMode == "on_site"
            || serviceMode == "takeaway"
            || serviceMode == "both"));
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create, update, delete: if isOwner(uid);
    }

    match /meals/{mealId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.hostId == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "host"
        && hostHasHaccp(request.auth.uid)
        && request.resource.data.priceCents is int
        && request.resource.data.priceCents > 0
        && request.resource.data.availablePortions is int
        && request.resource.data.availablePortions > 0
        && isValidServiceMode(request.resource.data.serviceMode);

      allow update: if isMealOwner()
        && request.resource.data.hostId == resource.data.hostId
        && isValidServiceMode(request.resource.data.serviceMode);

      allow delete: if isMealOwner();
    }

    match /orders/{orderId} {
      allow read: if isOrderParticipant();
      allow create: if isSignedIn() && isValidOrderCreate();
      allow update, delete: if false;
    }
  }
}
