rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isHost(uid) {
      return isOwner(uid)
        && get(/databases/$(database)/documents/users/$(uid)).data.role == "host";
    }

    function isOrderParticipant() {
      return isSignedIn()
        && (
          resource.data.clientId == request.auth.uid
          || resource.data.hostId == request.auth.uid
        );
    }

    function paymentStatusUnchanged() {
      return request.resource.data.paymentStatus == resource.data.paymentStatus;
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create, update, delete: if isOwner(uid);
    }

    match /meals/{mealId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.hostId == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "host"
        && request.resource.data.priceCents is int
        && request.resource.data.priceCents > 0
        && request.resource.data.availablePortions is int
        && request.resource.data.availablePortions > 0;

      allow update, delete: if isSignedIn()
        && resource.data.hostId == request.auth.uid
        && request.resource.data.hostId == resource.data.hostId;
    }

    match /orders/{orderId} {
      allow read: if isOrderParticipant();

      allow create: if isSignedIn()
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.paymentStatus == "requires_payment"
        && request.resource.data.amountCents is int
        && request.resource.data.amountCents > 0
        && request.resource.data.currency == "eur"
        && request.resource.data.hostStripeAccountId is string
        && (
          !request.resource.data.keys().hasAny(["paymentIntentId"])
          || request.resource.data.paymentIntentId == null
        );

      allow update: if isSignedIn() && (
        (
          resource.data.clientId == request.auth.uid
          && request.resource.data.clientId == resource.data.clientId
          && request.resource.data.hostId == resource.data.hostId
          && request.resource.data.mealId == resource.data.mealId
          && request.resource.data.hostStripeAccountId == resource.data.hostStripeAccountId
          && request.resource.data.amountCents == resource.data.amountCents
          && request.resource.data.currency == resource.data.currency
          && request.resource.data.paymentIntentId == resource.data.paymentIntentId
          && request.resource.data.status in ["pending", "cancelled"]
          && paymentStatusUnchanged()
        )
        ||
        (
          resource.data.hostId == request.auth.uid
          && request.resource.data.clientId == resource.data.clientId
          && request.resource.data.hostId == resource.data.hostId
          && request.resource.data.mealId == resource.data.mealId
          && request.resource.data.hostStripeAccountId == resource.data.hostStripeAccountId
          && request.resource.data.amountCents == resource.data.amountCents
          && request.resource.data.currency == resource.data.currency
          && request.resource.data.paymentIntentId == resource.data.paymentIntentId
          && request.resource.data.status in ["pending", "confirmed", "rejected", "cancelled"]
          && paymentStatusUnchanged()
        )
      );

      allow delete: if false;
    }
  }
}
